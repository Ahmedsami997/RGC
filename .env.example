# Copy these as Environment Variables in the Vercel project settings
# (Project -> Settings -> Environment Variables). Do NOT commit a real
# .env file with these values filled in — this file is a template only.

# Same values as .env.it_dashboard on the office machine:
ODOO_URL=https://mast-it-golf-main-15203359.dev.odoo.com
ODOO_DB=mast-it-golf-main-15203359
ODOO_USERNAME=ahmed@theroyalgolfclub.com
ODOO_API_KEY=

# Login(s) required to view the dashboard (checked by middleware.js).
# Comma-separated "username:password" pairs, one per person. Example shape
# only — set the real names/passwords directly in Vercel, never here:
DASHBOARD_USERS=Alice:changeme1,Bob:changeme2

# Legacy single-user alternative (still supported, merged in if set):
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Optional tuning:
PNL_MONTHS=9
PNL_CACHE_SECONDS=600
