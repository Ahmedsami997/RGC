<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RGC brand palette (taken from the Royal Golf Club crown logo + dashboard) -->
    <Color x:Key="NavyColor">#0C1730</Color>
    <Color x:Key="NavyMidColor">#16233A</Color>
    <Color x:Key="NavyLightColor">#1F3557</Color>
    <Color x:Key="GreenColor">#84CB49</Color>
    <Color x:Key="GreenDarkColor">#39983E</Color>
    <Color x:Key="GoldColor">#B8862F</Color>
    <Color x:Key="PaperColor">#F3F6F5</Color>
    <Color x:Key="LineColor">#DDE4E2</Color>
    <Color x:Key="InkColor">#0E1626</Color>
    <Color x:Key="MutedColor">#5B6B72</Color>
    <Color x:Key="AmberColor">#C98A12</Color>
    <Color x:Key="ClayColor">#C0392B</Color>

    <SolidColorBrush x:Key="Brand.Navy" Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="Brand.NavyMid" Color="{StaticResource NavyMidColor}" />
    <SolidColorBrush x:Key="Brand.NavyLight" Color="{StaticResource NavyLightColor}" />
    <SolidColorBrush x:Key="Brand.Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Brand.GreenDark" Color="{StaticResource GreenDarkColor}" />
    <SolidColorBrush x:Key="Brand.GreenSoft" Color="#E4F3EA" />
    <SolidColorBrush x:Key="Brand.Gold" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="Brand.Paper" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="Brand.Surface" Color="White" />
    <SolidColorBrush x:Key="Brand.Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Brand.Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Brand.Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Brand.OnNavyMuted" Color="#9FB0C4" />

    <SolidColorBrush x:Key="Priority.Normal" Color="{StaticResource GreenDarkColor}" />
    <SolidColorBrush x:Key="Priority.NormalSoft" Color="#E4F3EA" />
    <SolidColorBrush x:Key="Priority.Important" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="Priority.ImportantSoft" Color="#FBF0DC" />
    <SolidColorBrush x:Key="Priority.Critical" Color="{StaticResource ClayColor}" />
    <SolidColorBrush x:Key="Priority.CriticalSoft" Color="#FBE7E4" />

    <BitmapImage x:Key="Brand.Logo" UriSource="pack://application:,,,/RGC.Branding;component/Assets/rgc-logo.png" />
    <BitmapImage x:Key="Brand.Icon" UriSource="pack://application:,,,/RGC.Branding;component/Assets/rgc-icon.png" />

    <FontFamily x:Key="Brand.Font">Segoe UI</FontFamily>

    <!-- Buttons -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Brand.Font}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brand.GreenDark}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.GreenDark}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Line}" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Ink}" />
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Priority.Critical}" />
        <Setter Property="BorderBrush" Value="{StaticResource Priority.Critical}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Inputs -->
    <Style x:Key="Input.Text" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Brand.Font}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Ink}" />
    </Style>

    <Style x:Key="Input.Password" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource Brand.Font}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Brand.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Muted}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
    </Style>
</ResourceDictionary>
