<UserControl x:Class="RGC.Branding.Controls.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Brand.Font}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brand.Line}" BorderThickness="0,1,0,0" Padding="12,10" Background="White">
            <DockPanel>
                <TextBlock x:Name="NoticeText" DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource Brand.Muted}" Visibility="Collapsed" />
                <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Style="{StaticResource Button.Primary}"
                        Margin="8,0,0,0" Padding="18,0" VerticalAlignment="Stretch" Click="Send_Click" />
                <TextBox x:Name="Input" Style="{StaticResource Input.Text}" TextWrapping="Wrap" MaxLength="2000"
                         MinHeight="38" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="Input_PreviewKeyDown" ToolTip="Enter to send, Shift+Enter for a new line" />
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Background="{StaticResource Brand.Surface}" Padding="12,10">
            <Grid>
                <TextBlock x:Name="EmptyText" Text="No messages yet." HorizontalAlignment="Center" Margin="0,24,0,0"
                           Foreground="{StaticResource Brand.Muted}" FontSize="13" />
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MaxWidth="320" Margin="0,4" Padding="10,7" CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brand.Line}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mine}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Background" Value="{StaticResource Brand.GreenSoft}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brand.GreenSoft}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="{StaticResource Brand.Muted}" Margin="0,0,0,2">
                                        <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Time, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Brand.Ink}" Padding="0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
