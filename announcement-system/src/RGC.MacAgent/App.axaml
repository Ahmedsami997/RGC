<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RGC.MacAgent.App"
             Name="RGC Announcements"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#39983E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2F8034" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Styles>
    <Application.Resources>
        <SolidColorBrush x:Key="Navy" Color="#0C1730" />
        <SolidColorBrush x:Key="NavyLight" Color="#1F3557" />
        <SolidColorBrush x:Key="OnNavyMuted" Color="#9FB0C4" />
        <SolidColorBrush x:Key="Gold" Color="#B8862F" />
        <SolidColorBrush x:Key="Paper" Color="#F3F6F5" />
        <SolidColorBrush x:Key="Line" Color="#DDE4E2" />
        <SolidColorBrush x:Key="Ink" Color="#0E1626" />
        <SolidColorBrush x:Key="Muted" Color="#5B6B72" />
        <SolidColorBrush x:Key="Critical" Color="#C0392B" />
    </Application.Resources>
</Application>
