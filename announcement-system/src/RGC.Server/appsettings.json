{
  "ConnectionStrings": {
    "RgcDatabase": "Server=localhost;Database=RGC_Announcements;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Entra": {
    "TenantId": "",
    "ClientId": "",
    "AdminRole": "Admin"
  },
  "Authentication": {
    "AllowLocalAdminLogin": true,
    "AllowAgentKey": true
  },
  "Jwt": {
    "Issuer": "RGC.Server",
    "Audience": "RGC.AdminConsole",
    "SigningKey": "CHANGE-ME-to-a-long-random-secret-at-least-32-characters",
    "ExpiryHours": 8
  },
  "Announcements": {
    "AgentKey": "CHANGE-ME-shared-agent-key",
    "PendingDeliveryWindowHours": 72,
    "InactiveClientDays": 30,
    "MaxTitleLength": 200,
    "MaxMessageLength": 8000
  },
  "BootstrapAdmin": {
    "Username": "admin",
    "Password": "",
    "DisplayName": "RGC Administrator"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
