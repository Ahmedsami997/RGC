<Window x:Class="RGC.AdminConsole.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RGC – Sign in" Width="860" Height="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource Brand.Font}"
        Icon="pack://application:,,,/RGC.Branding;component/Assets/rgc-icon.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Background="{StaticResource Brand.Navy}">
            <Grid Margin="40">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="{StaticResource Brand.Logo}" Width="150" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="RGC" Foreground="White" FontSize="48" FontWeight="Bold" Margin="0,24,0,0" />
                    <TextBlock Text="Company Announcements" Foreground="{StaticResource Brand.Green}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Royal Golf Club" Foreground="{StaticResource Brand.OnNavyMuted}" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <TextBlock Text="Admin Console" Foreground="{StaticResource Brand.OnNavyMuted}" FontSize="11"
                           VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- Form -->
        <Grid Grid.Column="1" Background="{StaticResource Brand.Paper}">
            <StackPanel Width="340" VerticalAlignment="Center">
                <TextBlock Text="Sign in" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brand.Ink}" />
                <TextBlock Text="Administrators only. All sign-ins are logged." Foreground="{StaticResource Brand.Muted}"
                           FontSize="13" Margin="0,4,0,24" />

                <TextBlock Text="SERVER" Style="{StaticResource Text.Label}" />
                <TextBox x:Name="ServerBox" Style="{StaticResource Input.Text}" Margin="0,0,0,14" />

                <TextBlock Text="USERNAME" Style="{StaticResource Text.Label}" />
                <TextBox x:Name="UserBox" Style="{StaticResource Input.Text}" Margin="0,0,0,14" />

                <TextBlock Text="PASSWORD" Style="{StaticResource Text.Label}" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource Input.Password}" Margin="0,0,0,8" />

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Priority.Critical}" TextWrapping="Wrap"
                           FontSize="13" Margin="0,4,0,8" Visibility="Collapsed" />

                <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource Button.Primary}"
                        IsDefault="True" Margin="0,8,0,0" Click="SignIn_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
