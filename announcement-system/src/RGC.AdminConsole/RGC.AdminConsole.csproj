<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>RGC.Admin</AssemblyName>
    <RootNamespace>RGC.AdminConsole</RootNamespace>
    <ApplicationIcon>..\RGC.Branding\Assets\rgc.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RGC.Shared\RGC.Shared.csproj" />
    <ProjectReference Include="..\RGC.Branding\RGC.Branding.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="adminsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
