<Window x:Class="RGC.ClientAgent.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RGC.Branding.Controls;assembly=RGC.Branding"
        Title="RGC – IT support" Width="420" Height="540" MinWidth="340" MinHeight="360"
        WindowStartupLocation="Manual" ShowInTaskbar="True"
        FontFamily="{StaticResource Brand.Font}" Background="White"
        Icon="pack://application:,,,/RGC.Branding;component/Assets/rgc-icon.png">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Brand.Navy}" Padding="18,14">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource Brand.Logo}" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="IT support" Foreground="White" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Messages between you and the RGC IT team" Foreground="{StaticResource Brand.OnNavyMuted}" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>
        <controls:ChatPanel x:Name="Chat" />
    </DockPanel>
</Window>
