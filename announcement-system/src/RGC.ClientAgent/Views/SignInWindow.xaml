<Window x:Class="RGC.ClientAgent.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RGC – Sign in" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="{StaticResource Brand.Font}" Background="White"
        Icon="pack://application:,,,/RGC.Branding;component/Assets/rgc-icon.png">
    <StackPanel>
        <Border Background="{StaticResource Brand.Navy}" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource Brand.Logo}" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="RGC" Foreground="White" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Company Announcements" Foreground="{StaticResource Brand.OnNavyMuted}" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Margin="28,22,28,24">
            <TextBlock Text="Sign in to receive company announcements" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource Brand.Ink}" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,18" FontSize="13" Foreground="{StaticResource Brand.Muted}" TextWrapping="Wrap"
                       Text="Use your Royal Golf Club Microsoft 365 account (your work email). You only need to do this once on this computer." />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Priority.Critical}" TextWrapping="Wrap"
                       Margin="0,0,0,12" Visibility="Collapsed" />
            <Button x:Name="SignInButton" Content="Sign in with Microsoft 365" Style="{StaticResource Button.Primary}"
                    IsDefault="True" Click="SignIn_Click" />
            <Button Content="Later" Style="{StaticResource Button.Secondary}" Margin="0,8,0,0" Click="Later_Click" />
        </StackPanel>
    </StackPanel>
</Window>
