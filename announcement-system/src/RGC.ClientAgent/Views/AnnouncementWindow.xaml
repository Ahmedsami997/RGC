<Window x:Class="RGC.ClientAgent.Views.AnnouncementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RGC – Company Announcement"
        Width="680" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brand.Navy}"
        FontFamily="{StaticResource Brand.Font}"
        Icon="pack://application:,,,/RGC.Branding;component/Assets/rgc-icon.png">

    <Border BorderBrush="{StaticResource Brand.NavyLight}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- header -->
                <RowDefinition Height="Auto" />  <!-- priority accent -->
                <RowDefinition Height="*" />     <!-- body -->
                <RowDefinition Height="Auto" />  <!-- footer -->
            </Grid.RowDefinitions>

            <!-- Header: logo, app name, (hidden) close X -->
            <Grid Grid.Row="0" Background="{StaticResource Brand.Navy}" Height="64">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Image Source="{StaticResource Brand.Logo}" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RGC" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Royal Golf Club" Foreground="{StaticResource Brand.OnNavyMuted}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <Border x:Name="PriorityBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,72,0"
                        CornerRadius="12" Padding="12,4">
                    <TextBlock x:Name="PriorityText" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>
                <Button x:Name="CloseX" Width="44" Height="44" HorizontalAlignment="Right" Margin="0,0,12,0"
                        Visibility="Collapsed" Click="Close_Click" ToolTip="Close"
                        Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#C0392B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border x:Name="AccentBar" Grid.Row="1" Height="5" />

            <!-- Body -->
            <Border Grid.Row="2" Background="White" Padding="34,26,34,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="HeadingText" Grid.Row="0" Text="IMPORTANT COMPANY ANNOUNCEMENT"
                               FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brand.Gold}" />

                    <TextBlock x:Name="TitleText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap"
                               FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brand.Ink}" />

                    <TextBlock x:Name="MetaText" Grid.Row="2" Margin="0,6,0,16" FontSize="12"
                               Foreground="{StaticResource Brand.Muted}" />

                    <Border Grid.Row="3" BorderBrush="{StaticResource Brand.Line}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="MessageScroll_ScrollChanged">
                            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="15" LineHeight="23"
                                       Foreground="{StaticResource Brand.Ink}" Margin="0,0,8,0" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Footer: countdown + close button -->
            <Border Grid.Row="3" Background="{StaticResource Brand.Paper}" BorderBrush="{StaticResource Brand.Line}"
                    BorderThickness="0,1,0,0" Padding="34,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CountdownText" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brand.Ink}" TextWrapping="Wrap" />
                        <ProgressBar x:Name="CountdownBar" Height="4" Margin="0,8,24,0" BorderThickness="0"
                                     Background="{StaticResource Brand.Line}" Foreground="{StaticResource Brand.GreenDark}" />
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="1" Content="I have read this – Close"
                            Style="{StaticResource Button.Primary}" Visibility="Collapsed" IsEnabled="False"
                            Click="Close_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
