<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Company>Royal Golf Club</Company>
    <Product>RGC Announcements</Product>
    <Version>1.3.1</Version>
    <!-- Lets the WPF projects compile on non-Windows build machines/CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
